# ── Legend ─────────────────────────────────────────────────────────────────
#   [必填] Required — must be configured before startup
#   [选填] Optional — safe to leave unset (default applies / feature stays off)
# Copy this file to .env and fill in your values. Secrets go into .env only —
# never commit them.

# ── Database（PostgreSQL，默认存储）───────────────────────────────────────
# [必填] 完整连接串。账号密码、项目、会话、工具调用记录都存在这里。
# 生产/容器内请用服务名（compose 里是 postgres），本地直连用 127.0.0.1。
DATABASE_URL=postgresql+asyncpg://agents:agents@127.0.0.1:5432/agentsuniverse

# [选填] 不设 DATABASE_URL 时，用下面这些字段拼 postgresql+asyncpg URL。
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=agentsuniverse
# DB_USER=agents
# DB_PASSWORD=agents

# [选填] 连接池调优（默认 10 / 20 / 30）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# [选填] 旧部署回退：任意 SQLAlchemy 连接串（例如迁移前的 SQL Server 实例）。
# 优先级低于 DATABASE_URL。
# MSSQL_CONNECTION_STRING=

# ── Security ──────────────────────────────────────────────────────────────
# [必填] MUST be replaced — the API refuses to start while this value starts
# with "change-me" (decryptable token vault / forgeable username index otherwise).
# Token encryption and the user-field encryption keys derive from it.
# Generate one with either:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-secret

# ── Redis ─────────────────────────────────────────────────────────────────
# [必填] Redis URL for sessions + active-user tracking
REDIS_URL=redis://localhost:6379/0
# [选填] Redis password (omit when the server has no auth)
# REDIS_PASSWORD=

# ── App URLs ──────────────────────────────────────────────────────────────
# [必填] Public URLs of API and web UI (CORS, redirects).
# Defaults match the default Docker stack, where the api container's nginx
# serves the UI on :8000. For local vite dev (`npm run dev`), switch
# WEB_BASE_URL to http://localhost:5173.
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# [选填] Deploy behind a sub-path (e.g. /agents-universe)
# APP_ROOT_PATH=

# ── Storage ───────────────────────────────────────────────────────────────
# [必填 for local dev] ABSOLUTE path to directory where sub-project workspaces
# are stored. Each project gets its own subdirectory:
# {PROJECTS_ROOT}/{slug}/knowledge/
# Must exist on disk before starting the API (a warning is logged otherwise).
# Windows:  PROJECTS_ROOT=C:\Users\you\projects\agent-projects
# Linux:    PROJECTS_ROOT=/data/projects
# Docker:   ignored — docker-compose overrides this with the in-container path
# /app/projects; the host-side data directory is DOCKER_VOLUME_ROOT instead.
PROJECTS_ROOT=/data/projects

# [选填] Docker only: host directory for persistent data (projects, maven,
# gradle, redis bind mounts). Default ./data next to docker-compose.yml.
# DOCKER_VOLUME_ROOT=./data

# [选填] Max upload size in MB (default 10)
# MAX_UPLOAD_SIZE_MB=10

# ── Auth (local dev bypass) ───────────────────────────────────────────────
# [选填] 免登录旁路。默认关闭：多用户场景下必须保持关闭，否则所有请求都会
# 解析成同一个 dev-user，项目与会话隔离失效。关闭后通过前端 /login 页注册或
# 登录（本地用户名 + 密码，PBKDF2 哈希）。这是唯一的登录方式。
AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_USER_ID=dev-user

# [选填] OpenAPI 文档（/docs、/openapi.json）。默认关闭，避免把内部接口
# 清单暴露给普通用户；本地调试时临时设为 true。
API_DOCS_ENABLED=false
# [选填] 会话 Cookie 的 Secure 属性。留空 = 由 WEB_BASE_URL 推导（https ⇒ Secure）；
# 显式 true/false 覆盖推导结果。
# COOKIE_SECURE_OVERRIDE=false

# ── Session ───────────────────────────────────────────────────────────────
# [选填] Session / cookie / active-user window tuning (defaults shown)
# SESSION_TTL=86400
# AUTH_COOKIE_NAME=x-auth-token
# ACTIVE_USERS_WINDOW=300

# ── TLS / SSL ────────────────────────────────────────────────────────────
# [选填] Verify TLS certs for LLM providers and outbound tools.
# Default: false (corporate proxies often use internal CA). Set true in production.
LLM_SSL_VERIFY=false
# [选填] Verify TLS certs for Playwright browser requests (default true;
# set false to allow self-signed certs)
# BROWSER_SSL_VERIFY=true

# ── Outbound Proxy ───────────────────────────────────────────────────────
# [选填] One proxy for every outbound channel: LLM provider calls, the
# browser tool, code_executor sandboxes, the shell tool, the git and MCP
# transports, script/QA-Playwright runs (the scaffold playwright.config.ts
# hands it to Chromium explicitly — Playwright ignores the proxy env vars)
# (injected as HTTPS_PROXY/HTTP_PROXY/https_proxy/http_proxy — all four
# spellings carry the same resolved URL, an inherited ALL_PROXY is dropped so
# sandbox and browser cannot disagree, and empty placeholders are scrubbed so
# so semgrep never parses a blank URI). Credentials in the URL are masked before
# any tool output or log is written. Empty = no proxy.
#
# Intranet targets (the common corporate case): hosts that must be reached
# DIRECTLY — not through the proxy — belong in NO_PROXY/APP_NO_PROXY, or the
# proxy becomes the only route to them and an egress-only corporate proxy
# will refuse. APP_NO_PROXY is merged in at startup (alongside NO_PROXY and
# the LLM provider hosts) and inherited by every subprocess, npm install,
# and Playwright run:
#   APP_NO_PROXY=.corp.example.com,.intra.example.com,10.0.0.0/8,192.168.0.0/16
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# [选填] Extra NO_PROXY entries from .env (kept even if system NO_PROXY differs)
# APP_NO_PROXY=

# ── Logging ───────────────────────────────────────────────────────────────
# [选填] Log level and format (json | human)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ── Sandbox Network Policy ────────────────────────────────────────────────
# [选填] Network policy for Python code executed by agents (code_executor).
#   (unset)   -> allow all network access (default) — required for full
#                Playwright functionality: file downloads, screen recording,
#                any outbound API the agent's script needs
#   localhost  -> loopback only (127.0.0.1, ::1, localhost) — sandboxed code
#                may still reach the app itself, but nothing else
#   none       -> block all sockets (strictest; outbound calls fail)
# SANDBOX_NETWORK=

# ── System Default Model ──────────────────────────────────────────────────
# [选填] OpenAI-compatible fallback when a user has no personal model configs.
# Always treated as a base URL (code appends /v1/chat/completions as needed).
# SYSTEM_DEFAULT_MODEL_ID=gpt-4o
# SYSTEM_DEFAULT_BASE_URL=https://api.openai.com
# SYSTEM_DEFAULT_API_KEY=

# ── Integrations (Jira / Confluence / Git) ────────────────────────────────
# All entries below are [选填]. They only set SYSTEM-LEVEL default base URLs;
# each user's credentials live encrypted in the DB (user_tokens table,
# AES-256-GCM) and are configured per-user in the web UI — never in .env.

# Jira + Confluence share one Atlassian base URL. The auth mode is
# auto-derived from the domain — nothing else to configure:
#   Cloud:  https://example.atlassian.net  → basic auth (user provides
#           email + API token), no sub-paths
#   Server: https://jira.example.com   → bearer auth (user provides PAT),
#           /jira and /confluence sub-paths applied automatically
# Uncomment when you run Jira/Confluence. With no value, the integration
# list shows no default URL (users can still set their own).
# ATLASSIAN_BASE_URL=https://example.atlassian.net
# [选填] Verify TLS for Jira/Confluence (default false)
# ATLASSIAN_SSL_VERIFY=true

# Git repos — GitHub.com or GitHub Enterprise Server.
#   https://github.com            → default; REST API auto-routed to api.github.com
#   https://git.example.com  → GHE; REST API auto-routed to /api/v3
# Leave unset for GitHub.com (default). Token stays per-user in the DB.
# GIT_BASE_URL=https://github.com
# [选填] Verify TLS for GHE/GitHub (default false)
# GIT_SSL_VERIFY=true

# ── SSRF protection (agent outbound calls) ────────────────────────────────
# [选填] Opt-in DNS-level SSRF checks for agent HTTP tools (default off).
# When enabled, every outbound URL the agent requests is resolved and
# validated against internal ranges.
# SSRF_ENABLED=true
# [选填] Let the api_request tool reach loopback/private ranges
# (e.g. Kong admin, local Ollama). Default: blocked.
# THIRD_PARTY_API_ALLOW_PRIVATE=true

# ── Scheduled Tasks ───────────────────────────────────────────────────────
# [选填] In-process cron scheduler for the 定时任务 tab (default true).
# Runs one asyncio loop inside the API process — keep the deployment at a
# single replica. Set to false to disable all scheduled execution (useful in
# tests or when another environment owns the schedule).
# SCHEDULER_ENABLED=true
# [选填] Default timezone for newly created tasks (IANA name). Each task
# stores its own timezone; this only seeds the form.
# SCHEDULER_TIMEZONE=Asia/Shanghai

# ── Agent Delegation (智能体委派) ──────────────────────────────────────────
# [选填] Let an agent hand a subtask to another agent when it lacks the
# capability (default true). The delegated agent runs as a nested turn of the
# same conversation, its reply becomes its own message with its own attribution,
# and a summary returns to the agent that asked.
# Delegation is a privilege-escalation surface: a narrow agent can borrow a
# broad one's tools (code_executor, git_repo push, api_request). Set to false
# to disable it globally; narrow one agent's targets with `delegates_to:` in its
# frontmatter instead.
# AGENT_DELEGATION_ENABLED=true
# [选填] Maximum nesting depth: 2 = root -> child -> grandchild. 0 disables.
# AGENT_DELEGATION_MAX_DEPTH=2
# [选填] Seconds a single delegated turn may run before it is stopped and the
# caller is told it timed out (default 1800).
# AGENT_DELEGATION_TIMEOUT_SECONDS=1800

# ── Script / Playwright runs ──────────────────────────────────────────────
# [选填] How many script and Playwright runs may execute at once (default 3,
# clamped to 1..16). One global pool is shared by the run button, the agent's
# script_writer and scheduled tasks, so a Playwright run — a browser per
# worker — can make others queue. Raise it on a host with spare memory when
# several cards' specs run in parallel; lower it to 1 on a small box.
# SCRIPTS_CONCURRENCY_LIMIT=3
